    parser.add_argument('--project', type=Path)
    parser.add_argument('--json', action='store_true', help='Print the result as JSON instead of the outline')
    parser.add_argument('--agent-session')
    override_arguments(parser)
    args = parser.parse_args(argv)
    if not (args.detail or args.overrides):
        parser.error('pass --detail or a structure override')
    root = (args.project or Path.cwd()).resolve()
    target = choose(instances(), args.pane, session_key(args), root, [])
    if target is None:
        raise RuntimeError('No matching editor; supply the --pane from the outline')
    opts = {key: value for key, value in dict(detail=args.detail, overrides=args.overrides).items() if value is not None}
    result = deliver(target, 'ast_adjust', [opts], args.tour, timeout=60)
    print(json.dumps(result) if args.json else result['outline'])
    return 0


