def agent_main(argv):
    parser = argparse.ArgumentParser(prog='code-tour agent')
    parser.add_argument('operation', choices=('install', 'uninstall'))
    parser.add_argument('--project', type=Path)
    args = parser.parse_args(argv)
    root = (args.project or Path.cwd()).resolve()
    if not args.project:
        git = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
        if git.returncode == 0: root = Path(git.stdout.strip()).resolve()
    begin, end = '<!-- code-tour:section:start -->', '<!-- code-tour:section:end -->'
    block = '\n'.join((begin, '## code-tour',
        '- Before changing code you have not read, run `code-tour explain SYMBOL` or `code-tour flow ENTRY`.',
        '- Before changing behavior or a signature, run `code-tour impact SYMBOL`.',
        '- Treat notes as orientation and verify them against the source code.', end))
    changed = []
    for name in ('CLAUDE.md', 'AGENTS.md'):
        path = root / name
        content = path.read_text() if path.exists() else ''
        managed = re.compile(re.escape(begin) + r'.*?' + re.escape(end), re.DOTALL)
        if args.operation == 'install':
            if managed.search(content):
                updated = managed.sub(lambda _: block, content, count=1)
            else:
                updated = content.rstrip() + ('\n\n' if content.strip() else '') + block + '\n'
        else:
            updated = managed.sub('', content).rstrip() + ('\n' if content.strip() and managed.search(content) else '') \
                if managed.search(content) else content
        if updated != content:
            path.write_text(updated)
            changed.append(name)
    print(json.dumps(dict(operation=args.operation, files=changed, root=str(root))))
    return 0


def headless(command, opts):
    script = Path(__file__).resolve().parents[1] / 'lua/code-tour/ast/headless.lua'
    args = [os.environ.get('CODE_TOUR_NVIM', 'nvim'), '--headless', '-u', 'NONE', '-i', 'NONE', '-l', str(script), command]
    for key, value in opts.items():
        args += ['--' + key, str(value)]
    proc = subprocess.run(args, capture_output=True, text=True, timeout=600)
    lines = [line for line in proc.stdout.splitlines() if line.startswith('{')]
    if not lines:
        raise RuntimeError('headless Neovim failed: ' + (proc.stderr or proc.stdout).strip())
    result = json.loads(lines[-1])
    if proc.returncode != 0 or 'error' in result:
        raise RuntimeError(result.get('error') or proc.stderr.strip())
    return result


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == 'capabilities':
        print(json.dumps(dict(protocol=1, standalone=True, inspect=True, no_focus=True, lazy_agent=True, new_editor=True)))
        return 0
    if argv and argv[0] == 'saved':
        return saved_main(argv[1:])
    if argv and argv[0] == 'graph':
        return graph_main(argv[1:])
    if argv and argv[0] == 'codegraph':
        return codegraph_main(argv[1:])
    if argv and argv[0] == 'ast':
        return ast_main(argv[1:])
    if argv and argv[0] == 'analyze':
        return analyze_main(argv[1:])
    if argv and argv[0] == 'adjust':
        return adjust_main(argv[1:])
    if argv and argv[0] == 'brief':
        return brief_main(argv[1:])
    if argv and argv[0] == 'store':
        return store_main(argv[1:])
    if argv and argv[0] == 'scenario':
        return scenario_main(argv[1:])
    if argv and argv[0] == 'agent':
        return agent_main(argv[1:])
    if argv and argv[0] in ('explain', 'flow', 'callers', 'impact', 'path', 'search', 'note'):
        return knowledge_main(argv[0], argv[1:])
    if argv and argv[0] in ('show', 'answer', 'fill'):
        argv[0] = '--' + argv[0]
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--show', action='store_true', help='Default mode')
    mode.add_argument('--answer', nargs='?', const='', metavar='S.K')
    mode.add_argument('--fill', metavar='ID')
    parser.add_argument('--markdown', action='store_true', help='--fill: the input is Markdown sections, never parsed as JSON')
    parser.add_argument('--append', action='store_true')
    parser.add_argument('--review', action='store_true', default=None, help='Show additions and removed virtual lines (show or fill)')
    parser.add_argument('--base', help='Git review base, default HEAD')
    place = parser.add_mutually_exclusive_group()
    place.add_argument('--after', type=int)
    place.add_argument('--into', '--int', dest='into', metavar='N.K')
    parser.add_argument('--pane', help='Neovim socket path (or, under Herdr, a pane id or session/pane)')
    parser.add_argument('--tour', help='Tour identity supplied by an editor response command')
    parser.add_argument('--detail', choices=('overview', 'normal', 'detailed', 'exhaustive'),
                        help='AST fills: the detail the bodies are written at (default: the tour\'s)')
    parser.add_argument('--model', help='AST fills: the model that wrote the bodies (recorded with them)')
    parser.add_argument('--project', type=Path)
    parser.add_argument('--file', help='Read stops from JSON file instead of stdin')
    parser.add_argument('--agent-session')
    parser.add_argument('--origin-session')
    parser.add_argument('--origin-pane')
    parser.add_argument('--list', action='store_true')
    parser.add_argument('ranges', nargs='*', metavar='FILE:LINE-END')
    args = parser.parse_args(argv)
    if args.fill and not re.fullmatch(r'n\d+|[0-9a-f]{16}', args.fill):
        parser.error(f'invalid fill id {args.fill!r}: fill ids look like n13 (a snippet from the outline)')
    if args.markdown and not args.fill:
        parser.error('--markdown requires --fill')
    if (args.after is not None or args.into) and not args.fill:
        parser.error('--after/--into require --fill')
    if (args.detail or args.model) and not args.fill:
        parser.error('--detail/--model require --fill')
    if args.base and not args.review:
        parser.error('--base requires --review')
    live = instances()
    if args.list:
        print(json.dumps(live, indent=2))
        return 0
    data = None if args.answer is not None else read_stops(args)
    root = (args.project or Path.cwd()).resolve()
    if not args.project:
        git = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
        if git.returncode == 0:
            root = Path(git.stdout.strip()).resolve()
    # Relative filenames are relative to the caller's cwd unless --project was explicit.
    data_root = (args.project or Path.cwd()).resolve()
    if data is not None:
        # A fill may also answer {"unresolved": reason}; anything else is a list of stops.
        items = data if isinstance(data, list) else []
        files = resolve_stops(items, data_root)
    else:
        files = []
    key = session_key(args)
    target = choose(live, args.pane, key, root, files)
    if target is None:
        if args.answer is not None or args.fill:
            raise RuntimeError('No matching editor for this response; supply the --pane from the request.')
        target = launch(root)
    if args.answer is not None:
        answer_args = [sys.stdin.read()]
        if args.answer:
            answer_args.append(args.answer)
        result = deliver(target, 'answer', answer_args, args.tour)
    elif args.fill:
        placement = {key: value for key, value in dict(after=args.after, into=args.into,
                     review=args.review, base=args.base, detail=args.detail, model=args.model).items()
                     if value is not None}
        result = deliver(target, 'fill', [args.fill, data, placement], args.tour)
    else:
        # Large nested tours exceed msgpack-RPC's nesting limit, so the editor reads the file itself.
        path = tour_file(args, data)
        opts = dict(root=str(root), append=args.append, review=args.review, base=args.base,
                    origin=origin(args, root), cli=entry_path(),
                    tour_file=None if args.append else path)
        opts = {key: value for key, value in opts.items() if value is not None}
        result = rpc(target['address'], 'return require("tour").show_file(...)', [path, opts], timeout=15)
    remember(key, target)
    # The editor decides whether a reply should move the reader.
    if args.answer is None and (not args.fill or result.get('navigate')):
        try:
            focus(target)
        except (RuntimeError, OSError, subprocess.TimeoutExpired) as error:
            print(json.dumps(dict(result=result, focused=False, error=str(error))))
            return 1
    print(json.dumps(result))
    if isinstance(result, dict) and result.get('warning'):
        print('warning: ' + result['warning'], file=sys.stderr)
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Ambiguous as error:
        print(json.dumps(dict(error=str(error), instances=error.choices), indent=2), file=sys.stderr)
        raise SystemExit(2)
    except (RuntimeError, OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as error:
        print(json.dumps(dict(error=str(error))) if len(sys.argv) > 1 and sys.argv[1] == 'saved' else str(error), file=sys.stderr)
        raise SystemExit(1)
