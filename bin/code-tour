#!/usr/bin/env python3
"""Show code tours and return answers/fills over Neovim's MessagePack RPC socket."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import socket
import subprocess
import sys
import tempfile
import time


def herdr(*args, session=None):
    argv = [os.environ.get('HERDR_BIN_PATH', 'herdr')]
    if session:
        argv += ['--session', session]
    result = subprocess.run([*argv, *args], capture_output=True, text=True, timeout=15)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or 'Herdr request failed')
    data = json.loads(result.stdout) if result.stdout.strip() else {}
    if data.get('error'):
        raise RuntimeError(str(data['error']))
    return data.get('result', data)


def rpc(address, code, args=(), timeout=3):
    try:
        import msgpack
    except ImportError as error:
        raise RuntimeError('Python msgpack is required (Debian/Ubuntu: python3-msgpack)') from error
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as stream:
        stream.settimeout(timeout)
        stream.connect(address)
        stream.sendall(msgpack.packb([0, 1, 'nvim_exec_lua', [code, list(args)]], use_bin_type=True))
        unpacker = msgpack.Unpacker(raw=False, strict_map_key=False)
        while True:
            chunk = stream.recv(65536)
            if not chunk:
                raise RuntimeError('Editor disconnected before replying')
            unpacker.feed(chunk)
            for response in unpacker:
                if response[0] == 1 and response[1] == 1:
                    if response[2]:
                        raise RuntimeError(str(response[2]))
                    return response[3]


def inspect(address):
    plugin = str(Path(__file__).resolve().parents[1])
    return rpc(address, '''local plugin=...
      if not vim.tbl_contains(vim.opt.rtp:get(), plugin) then vim.opt.rtp:prepend(plugin) end
      return {editor_pid=vim.fn.getpid(),
      instance_id=require("code-tour.instance").id(), address=vim.v.servername,
      cwd=vim.fn.getcwd(), session=vim.env.HERDR_SESSION,
      pane_id=vim.env.HERDR_PANE_ID, tab_id=vim.env.HERDR_TAB_ID}''', [plugin])


def deliver(target, method, arguments, token=None, timeout=3):
    if token:
        code = ('local args={...}; local token=table.remove(args,1); local tour=require("tour"); '
                'assert(tour.state().id == token, "This response belongs to a replaced tour"); '
                f'return tour.{method}(unpack(args))')
        return rpc(target['address'], code, [token, *arguments], timeout=timeout)
    return rpc(target['address'], f'return require("tour").{method}(...)', arguments, timeout=timeout)


def instances():
    state = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state'))
    directory = state / os.environ.get('NVIM_APPNAME', 'nvim') / 'code-tour/instances'
    result = []
    for path in directory.glob('*.json'):
        try:
            record = json.loads(path.read_text())
            if not record.get('address'):
                continue
            live = inspect(record['address'])
            if (live['editor_pid'], live['instance_id']) == (record['editor_pid'], record['instance_id']):
                result.append(live)
        except (OSError, ValueError, RuntimeError, KeyError):
            continue
    return result


def session_key(args):
    return args.agent_session or os.environ.get('CODEX_THREAD_ID') or os.environ.get('CLAUDE_SESSION_ID')


def cache_path(key):
    directory = Path(tempfile.gettempdir()) / f'code-tour-{os.getuid()}'
    directory.mkdir(mode=0o700, exist_ok=True)
    if directory.is_symlink() or directory.stat().st_uid != os.getuid():
        raise RuntimeError('Unsafe tour cache directory')
    directory.chmod(0o700)
    return directory / ('rpc-' + hashlib.sha256(key.encode()).hexdigest() + '.json')


def remember(key, target):
    if not key:
        return
    path = cache_path(key)
    with tempfile.NamedTemporaryFile('w', dir=path.parent, delete=False) as stream:
        json.dump(target, stream)
        temporary = stream.name
    os.replace(temporary, path)


def choose(live, pane, key, root, files):
    if pane:
        matches = [item for item in live if pane in (item.get('pane_id'), item['address'],
                   f"{item.get('session')}/{item.get('pane_id')}")]
        if len(matches) == 1:
            return matches[0]
        if not matches and Path(pane).is_socket():
            return inspect(pane)
        raise RuntimeError('Pane is missing, ambiguous, or has no registered tour plugin: ' + pane)
    if key:
        try:
            cached = json.loads(cache_path(key).read_text())
            for item in live:
                if item['instance_id'] == cached['instance_id'] and item['address'] == cached['address']:
                    return item
        except (OSError, ValueError, KeyError):
            pass
    workspace = [item for item in live if Path(item['cwd']).resolve().is_relative_to(root)]
    if len(workspace) > 1:
        raise Ambiguous(workspace)
    if workspace:
        return workspace[0]
    contains = [item for item in live if files and all(path.is_relative_to(Path(item['cwd']).resolve()) for path in files)]
    if contains:
        # Prefer the closest enclosing cwd; ties require a user choice.
        depth = max(len(Path(item['cwd']).parts) for item in contains)
        closest = [item for item in contains if len(Path(item['cwd']).parts) == depth]
        if len(closest) > 1:
            raise Ambiguous(closest)
        return closest[0]
    return None


class Ambiguous(RuntimeError):
    def __init__(self, choices):
        self.choices = choices
        super().__init__('Several Neovim instances match. Ask the user which --pane to use.')


def launch(root):
    session = os.environ.get('HERDR_SESSION')
    if not session:
        raise RuntimeError('No editor found. Automatic new-tab launch requires a Herdr session.')
    result = herdr('tab', 'create', '--cwd', str(root), '--label', 'Code tour', '--no-focus', session=session)
    pane = result['root_pane']['pane_id']
    address = str(Path(tempfile.gettempdir()) / f'code-tour-{os.getuid()}-{os.getpid()}.sock')
    plugin = Path(__file__).resolve().parents[1]
    # Make the tour available even if this Neovim config has not loaded the plugin.
    setup = 'lua vim.opt.rtp:prepend(' + json.dumps(str(plugin)) + '); require("code-tour").setup()'
    argv = ['nvim', '--listen', address, '-c', setup]
    herdr('pane', 'run', pane, shlex.join(argv), session=session)
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        try:
            return inspect(address)
        except (OSError, RuntimeError):
            time.sleep(0.1)
    raise RuntimeError(f'Created pane {pane}, but its Neovim RPC socket did not become ready; inspect that tab before retrying.')


def focus(target):
    session, tab, pane = target.get('session'), target.get('tab_id'), target.get('pane_id')
    if not session or not tab:
        return
    herdr('tab', 'focus', tab, session=session)
    panes = [p for p in herdr('pane', 'list', session=session).get('panes', []) if p['tab_id'] == tab]
    if len(panes) <= 1:
        return
    # Herdr's ordinary pane focus is directional. Resolve an edge that lands on
    # the desired pane without changing split sizes, zoom, or terminal contents.
    for source in panes:
        if source['pane_id'] == pane:
            continue
        for direction in ('left', 'right', 'up', 'down'):
            neighbor = herdr('pane', 'neighbor', '--pane', source['pane_id'], '--direction', direction, session=session)
            if neighbor.get('neighbor', neighbor).get('neighbor_pane_id') == pane:
                herdr('pane', 'focus', '--pane', source['pane_id'], '--direction', direction, session=session)
                return
    raise RuntimeError(f'Tab focused, but could not focus pane {pane}')


def origin(args, root):
    session = args.origin_session or os.environ.get('HERDR_SESSION')
    pane = args.origin_pane or os.environ.get('HERDR_PANE_ID')
    if not session:
        return None
    agents = herdr('agent', 'list', session=session).get('agents', [])
    candidates = [a for a in agents if a.get('agent') in ('claude', 'codex')]
    chosen = next((a for a in candidates if a['pane_id'] == pane), None)
    if chosen is None and not args.origin_pane:
        key = session_key(args)
        matched = [a for a in candidates if key and (a.get('agent_session') or {}).get('value') == key]
        if len(matched) == 1:
            chosen = matched[0]
    if chosen is None:
        raise RuntimeError('Cannot identify the authoring conversation. Pass --origin-session and --origin-pane.')
    info = herdr('pane', 'process-info', '--pane', chosen['pane_id'], session=session)['process_info']
    pids = [p['pid'] for p in info.get('foreground_processes', [])]
    if not pids:
        raise RuntimeError('Originating agent process is missing')
    result = dict(session=session, pane_id=chosen['pane_id'], tab_id=chosen['tab_id'], agent=chosen['agent'], process_ids=pids)
    identity = (chosen.get('agent_session') or {}).get('value')
    if identity:
        result['agent_session'] = identity
    return result


def read_stops(args):
    if args.ranges:
        result = []
        for value in args.ranges:
            match = re.fullmatch(r'(.+):(\d+)(?:-(\d+))?', value)
            if not match:
                raise RuntimeError('Expected FILE:LINE-END: ' + value)
            path, first, last = match.groups()
            result.append(dict(file=path, start=int(first), end=int(last or first), title=Path(path).name,
                               note=f'{path}:{first}-{last or first}'))
        return result
    return json.loads(Path(args.file).read_text() if args.file else sys.stdin.read())


def resolve_stops(items, root):
    """Resolve every call's file in the caller's cwd, including nested parts."""
    files = []
    for item in items:
        item['file'] = str((root / item['file']).resolve())
        files.append(Path(item['file']))
        for box in [item, *item.get('parts', [])]:
            files.extend(resolve_stops(box.get('calls', []), root))
    return files


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in ('show', 'answer', 'fill'):
        argv[0] = '--' + argv[0]
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--show', action='store_true', help='Default mode')
    mode.add_argument('--answer', nargs='?', const='', metavar='S.K')
    mode.add_argument('--fill', metavar='ID')
    parser.add_argument('--append', action='store_true')
    parser.add_argument('--review', action='store_true', default=None, help='Show additions and removed virtual lines (show or fill)')
    parser.add_argument('--base', help='Git review base, default HEAD')
    place = parser.add_mutually_exclusive_group()
    place.add_argument('--after', type=int)
    place.add_argument('--into', '--int', dest='into', metavar='N.K')
    parser.add_argument('--pane', help='Herdr pane, session/pane, or Neovim socket path')
    parser.add_argument('--tour', help='Tour identity supplied by an editor response command')
    parser.add_argument('--project', type=Path)
    parser.add_argument('--file', help='Read stops from JSON file instead of stdin')
    parser.add_argument('--agent-session')
    parser.add_argument('--origin-session')
    parser.add_argument('--origin-pane')
    parser.add_argument('--list', action='store_true')
    parser.add_argument('ranges', nargs='*', metavar='FILE:LINE-END')
    args = parser.parse_args(argv)
    if (args.after is not None or args.into) and not args.fill:
        parser.error('--after/--into require --fill')
    if args.base and not args.review:
        parser.error('--base requires --review')
    live = instances()
    if args.list:
        print(json.dumps(live, indent=2))
        return 0
    data = None if args.answer is not None else read_stops(args)
    root = (args.project or Path.cwd()).resolve()
    if not args.project:
        git = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
        if git.returncode == 0:
            root = Path(git.stdout.strip()).resolve()
    # Relative filenames are relative to the caller's cwd unless --project was explicit.
    data_root = (args.project or Path.cwd()).resolve()
    if data is not None:
        items = data.get('snippets', []) if isinstance(data, dict) else data
        files = resolve_stops(items, data_root)
    else:
        files = []
    key = session_key(args)
    target = choose(live, args.pane, key, root, files)
    if target is None:
        if args.answer is not None or args.fill:
            raise RuntimeError('No matching editor for this response; supply the --pane from the request.')
        target = launch(root)
    if args.answer is not None:
        answer_args = [sys.stdin.read()]
        if args.answer:
            answer_args.append(args.answer)
        result = deliver(target, 'answer', answer_args, args.tour)
    elif args.fill:
        placement = {key: value for key, value in dict(after=args.after, into=args.into,
                     review=args.review, base=args.base).items() if value is not None}
        result = deliver(target, 'fill', [args.fill, data, placement], args.tour)
    else:
        opts = dict(root=str(root), append=args.append, review=args.review, base=args.base,
                    origin=origin(args, root), cli=str(Path(__file__).resolve()))
        opts = {key: value for key, value in opts.items() if value is not None}
        result = rpc(target['address'], 'return require("tour").show(...)', [data, opts], timeout=15)
    remember(key, target)
    # The editor decides whether a reply should move the reader.
    if args.answer is None and (not args.fill or result.get('navigate')):
        try:
            focus(target)
        except (RuntimeError, OSError, subprocess.TimeoutExpired) as error:
            print(json.dumps(dict(result=result, focused=False, error=str(error))))
            return 1
    print(json.dumps(result))
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Ambiguous as error:
        print(json.dumps(dict(error=str(error), instances=error.choices), indent=2), file=sys.stderr)
        raise SystemExit(2)
    except (RuntimeError, OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
