def budget_knowledge(result, budget):
    """Cap knowledge JSON, keeping all gists ahead of any optional body text."""
    result = deepcopy(result)
    limit = max(1, budget) * 4

    def size():
        return len(json.dumps(result, ensure_ascii=False, separators=(',', ':')).encode('utf-8'))

    if size() <= limit:
        return result

    bodies = []

    def remove_bodies(value):
        if isinstance(value, dict):
            if 'body' in value:
                bodies.append((value, value.pop('body')))
            for child in list(value.values()):
                remove_bodies(child)
        elif isinstance(value, list):
            for child in value:
                remove_bodies(child)

    remove_bodies(result)
    result['truncated'] = True

    # If gists and structure alone exceed the cap, discard optional test metadata,
    # then trim the ends of ranked result lists. Earlier, higher ranked gists survive.
    def drop_optional(value):
        if isinstance(value, dict):
            value.pop('tests', None)
            value.pop('example', None)
            for child in value.values():
                drop_optional(child)
        elif isinstance(value, list):
            for child in value:
                drop_optional(child)

    drop_optional(result)
    ranked = {'callers', 'paths', 'results', 'symbols', 'snippets', 'route'}

    def trim_ranked(value):
        if isinstance(value, dict):
            for key, child in value.items():
                if key in ranked and isinstance(child, list):
                    while child and size() > limit:
                        child.pop()
                trim_ranked(child)
        elif isinstance(value, list):
            for child in value:
                trim_ranked(child)

    trim_ranked(result)
    if size() <= limit:
        for owner, body in bodies:
            owner['body'] = body
            if size() > limit:
                owner.pop('body', None)
        return result

    # A very small budget cannot fit the structural envelope. Return a valid,
    # explicit truncation marker instead of breaking JSON or exceeding the cap.
    return {'truncated': True}


def knowledge_main(command, argv):
    parser = argparse.ArgumentParser(prog='code-tour ' + command)
    if command == 'path':
        parser.add_argument('symbol')
        parser.add_argument('target')
    elif command == 'note':
        parser.add_argument('symbol')
        parser.add_argument('file', type=Path, help='Markdown sections to write')
    elif command == 'search':
        parser.add_argument('query')
    else:
        parser.add_argument('symbol')
    parser.add_argument('--through', action='append', default=[])
    if command in ('flow', 'explain', 'note'):
        override_arguments(parser)  # --route/--walk/--branch name the flow to show; the plugin never picks one
    parser.add_argument('--detail', choices=('overview', 'normal', 'detailed', 'exhaustive'))
    parser.add_argument('--model')
    parser.add_argument('--budget', type=int, help='Approximate output cap in tokens')
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--project', type=Path)
    parser.add_argument('--pane', help='Use a running editor (including unsaved buffers)')
    parser.add_argument('--agent-session')
    args = parser.parse_args(argv)
    if args.budget is not None and args.budget < 1:
        parser.error('--budget must be positive')
    root = (args.project or Path.cwd()).resolve()
    if not args.project:
        git = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
        if git.returncode == 0:
            root = Path(git.stdout.strip()).resolve()
    req = dict(root=str(root), symbol=getattr(args, 'symbol', None), target=getattr(args, 'target', None),
               query=getattr(args, 'query', None), through=args.through, detail=args.detail, model=args.model,
               budget=args.budget, overrides=getattr(args, 'overrides', None))
    req = {k: v for k, v in req.items() if v is not None}
    if command == 'note':
        req['markdown'] = args.file.read_text()
        action = 'note'
    elif command == 'flow':
        action = 'flow'
    else:
        action = command
    req['action'] = action
    if args.pane:
        target = choose(instances(), args.pane, session_key(args), root, [])
        if target is None:
            raise RuntimeError('No matching editor; check --pane')
        result = rpc(target['address'], 'return require("tour").know(...)', [action, req], timeout=120)
    else:
        # Markdown is transported through a temporary file so it cannot be mistaken
        # for a CLI option or truncated by shell argument limits.
        if command == 'note':
            with tempfile.NamedTemporaryFile('w', encoding='utf-8', delete=False) as stream:
                stream.write(req.pop('markdown'))
                markdown_path = stream.name
            try:
                result = headless('knowledge', dict(request=json.dumps(req), input=markdown_path))
            finally:
                Path(markdown_path).unlink(missing_ok=True)
        else:
            result = headless('knowledge', dict(request=json.dumps(req)))
    if args.budget:
        result = budget_knowledge(result, args.budget)
    print(json.dumps(result, ensure_ascii=False, indent=None if args.json or args.budget else 2))
    return 0


def store_main(argv):
    parser = argparse.ArgumentParser(prog='code-tour store')
    parser.add_argument('--prune', action='store_true', required=True)
    parser.add_argument('--project', type=Path)
    parser.add_argument('--pane')
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args(argv)
    root = (args.project or Path.cwd()).resolve()
    if not args.project:
        git = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
        if git.returncode == 0: root = Path(git.stdout.strip()).resolve()
    if args.pane:
        target = choose(instances(), args.pane, None, root, [])
        if target is None: raise RuntimeError('No matching editor; check --pane')
        result = rpc(target['address'], 'return require("tour").store_prune(...)', [dict(root=str(root))], timeout=120)
    else:
        result = headless('store', dict(root=str(root)))
    print(json.dumps(result, ensure_ascii=False))
    return 0


